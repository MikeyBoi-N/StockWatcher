rules_version = '2';

// Each signed-in user can only read and write their own profile document: users/{uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'watchlist', 'addedStocks', 'createdAt', 'updatedAt'])
        && request.resource.data.watchlist is list
        && request.resource.data.watchlist.size() <= 500
        && request.resource.data.addedStocks is map;
    }
  }
}
